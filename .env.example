# Gemini API
# Get a free key at https://aistudio.google.com/app/apikey
# Required for v2 and v3. Not used by v1.
GEMINI_API_KEY=

# Optional: which Gemini model to use
GEMINI_MODEL=gemini-2.5-flash

# TTS
# Default Kokoro voice (used by v3)
KOKORO_VOICE=af_heart

# App
DEBUG=true
APP_NAME=PDF to Speech
API_PREFIX=/api/v1
